{
  "AnswerEnvelope": {
    "$defs": {
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "refs": {
            "items": {
              "type": "string"
            },
            "title": "Refs",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Claim",
        "type": "object"
      },
      "Clarification": {
        "additionalProperties": false,
        "properties": {
          "options": {
            "items": {
              "type": "string"
            },
            "title": "Options",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "Clarification",
        "type": "object"
      },
      "EvidenceItem": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "ref": {
            "title": "Ref",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "label",
          "value"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "ProposalCard": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "enum": [
              "remediation_ticket",
              "replacement_flag"
            ],
            "title": "Action Type",
            "type": "string"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "expected_effect": {
            "title": "Expected Effect",
            "type": "string"
          },
          "payload_hash": {
            "title": "Payload Hash",
            "type": "string"
          },
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "scope": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Scope",
            "type": "object"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "rejected",
              "executed",
              "failed",
              "uncertain",
              "invalidated"
            ],
            "title": "Status",
            "type": "string"
          },
          "target_device_id": {
            "title": "Target Device Id",
            "type": "string"
          },
          "target_label": {
            "title": "Target Label",
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "action_type",
          "company_id",
          "target_device_id",
          "target_label",
          "rationale",
          "evidence_refs",
          "scope",
          "expected_effect",
          "status",
          "payload_hash"
        ],
        "title": "ProposalCard",
        "type": "object"
      },
      "ScopeInfo": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "calculation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calculation"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "population": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Population"
          },
          "rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rule"
          }
        },
        "required": [
          "company_id",
          "as_of"
        ],
        "title": "ScopeInfo",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The only shape the agent returns. The UI maps it to fixed components; the LLM never emits markup.",
    "properties": {
      "claims": {
        "items": {
          "$ref": "#/$defs/Claim"
        },
        "title": "Claims",
        "type": "array"
      },
      "clarification": {
        "anyOf": [
          {
            "$ref": "#/$defs/Clarification"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceItem"
        },
        "title": "Evidence",
        "type": "array"
      },
      "headline": {
        "title": "Headline",
        "type": "string"
      },
      "notes": {
        "items": {
          "type": "string"
        },
        "title": "Notes",
        "type": "array"
      },
      "outcome": {
        "enum": [
          "answer",
          "no_match",
          "insufficient_data",
          "clarification",
          "proposal",
          "denied",
          "unsupported",
          "tool_error"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "proposal": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProposalCard"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "scope": {
        "$ref": "#/$defs/ScopeInfo"
      }
    },
    "required": [
      "outcome",
      "headline",
      "scope"
    ],
    "title": "AnswerEnvelope",
    "type": "object"
  },
  "TraceEvent": {
    "additionalProperties": false,
    "properties": {
      "data": {
        "additionalProperties": true,
        "title": "Data",
        "type": "object"
      },
      "kind": {
        "enum": [
          "plan",
          "tool_call",
          "tool_result",
          "verify",
          "respond",
          "error"
        ],
        "title": "Kind",
        "type": "string"
      },
      "latency_ms": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Latency Ms"
      },
      "seq": {
        "title": "Seq",
        "type": "integer"
      },
      "summary": {
        "title": "Summary",
        "type": "string"
      }
    },
    "required": [
      "seq",
      "kind",
      "summary"
    ],
    "title": "TraceEvent",
    "type": "object"
  }
}
