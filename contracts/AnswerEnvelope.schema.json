{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "title": "Device Ids",
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "refs",
        "count",
        "device_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What the answer covered and what it could not: the disclosures a reviewer needs.",
      "properties": {
        "excluded": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "out_of_scope",
              "unknown_version",
              "insufficient_history",
              "no_reading",
              "no_readings"
            ]
          },
          "title": "Excluded",
          "type": "object"
        },
        "missing_latest": {
          "items": {
            "type": "string"
          },
          "title": "Missing Latest",
          "type": "array"
        },
        "population": {
          "minimum": 0,
          "title": "Population",
          "type": "integer"
        },
        "stale": {
          "items": {
            "type": "string"
          },
          "title": "Stale",
          "type": "array"
        }
      },
      "required": [
        "population",
        "stale",
        "missing_latest",
        "excluded"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EntityList": {
      "additionalProperties": false,
      "description": "An ordered list shown to the user, so 'the first one' can be resolved against it.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "list_id": {
          "minLength": 1,
          "title": "List Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "list_id",
        "title",
        "items"
      ],
      "title": "EntityList",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "device_id",
        "label"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "label",
        "value"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "ProposalCard": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "remediation_ticket",
            "replacement_flag",
            "upgrade_order",
            "employee_notification"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_effect": {
          "title": "Expected Effect",
          "type": "string"
        },
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "executed",
            "failed",
            "uncertain",
            "invalidated"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_device_id": {
          "title": "Target Device Id",
          "type": "string"
        },
        "target_label": {
          "title": "Target Label",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "action_type",
        "company_id",
        "target_device_id",
        "target_label",
        "rationale",
        "evidence_refs",
        "scope",
        "expected_effect",
        "status",
        "payload_hash"
      ],
      "title": "ProposalCard",
      "type": "object"
    },
    "ScopeInfo": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "calculation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "population": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "company_id",
        "as_of",
        "rule",
        "population",
        "calculation"
      ],
      "title": "ScopeInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only shape the agent returns. The UI maps it to fixed components; the LLM never emits markup.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_lists": {
      "items": {
        "$ref": "#/$defs/EntityList"
      },
      "title": "Entity Lists",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "answer",
        "no_match",
        "insufficient_data",
        "clarification",
        "proposal",
        "denied",
        "unsupported",
        "tool_error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "no_matching_records",
            "insufficient_history",
            "not_found",
            "off_topic",
            "unsupported_action",
            "prompt_injection",
            "tool_failure",
            "step_limit",
            "not_eligible",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "scope": {
      "$ref": "#/$defs/ScopeInfo"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "trace_id",
    "headline",
    "claims",
    "evidence",
    "scope",
    "clarification",
    "proposal",
    "notes",
    "coverage",
    "entity_lists",
    "reason_code",
    "explanation"
  ],
  "title": "AnswerEnvelope",
  "type": "object"
}
