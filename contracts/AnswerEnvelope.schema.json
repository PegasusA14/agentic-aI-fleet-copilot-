{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "A question the copilot can answer, offered after a refusal. Code-written; `request` is sent as the next message.",
      "properties": {
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "request": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Request",
          "type": "string"
        }
      },
      "required": [
        "label",
        "request"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AnswerTable": {
      "additionalProperties": false,
      "description": "A list answer as a table. Every cell is code-written from tool records; the rows are already sorted.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "default_sort": {
          "$ref": "#/$defs/SortSpec"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 50,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "total_rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Rows"
        }
      },
      "required": [
        "title",
        "columns",
        "rows",
        "total_rows",
        "default_sort"
      ],
      "title": "AnswerTable",
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "description": "One value in a table row: `display` is what is shown, `value` is what a sort compares.",
      "properties": {
        "display": {
          "maxLength": 120,
          "title": "Display",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "attention",
                "ok"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "display",
        "value",
        "tone"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "device_ids": {
          "items": {
            "type": "string"
          },
          "title": "Device Ids",
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "refs",
        "count",
        "device_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "device",
            "text",
            "number",
            "percent",
            "version",
            "pill",
            "date"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "kind"
      ],
      "title": "Column",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What the answer covered and what it could not: the disclosures a reader needs to judge it.",
      "properties": {
        "excluded": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "out_of_scope",
              "unknown_version",
              "insufficient_history",
              "no_reading",
              "no_readings"
            ]
          },
          "title": "Excluded",
          "type": "object"
        },
        "excluded_devices": {
          "items": {
            "$ref": "#/$defs/ExcludedDevice"
          },
          "maxItems": 100,
          "title": "Excluded Devices",
          "type": "array"
        },
        "missing_latest": {
          "items": {
            "type": "string"
          },
          "title": "Missing Latest",
          "type": "array"
        },
        "population": {
          "minimum": 0,
          "title": "Population",
          "type": "integer"
        },
        "stale": {
          "items": {
            "type": "string"
          },
          "title": "Stale",
          "type": "array"
        }
      },
      "required": [
        "population",
        "stale",
        "missing_latest",
        "excluded",
        "excluded_devices"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EntityList": {
      "additionalProperties": false,
      "description": "An ordered list shown to the user, so 'the first one' can be resolved against it.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "list_id": {
          "minLength": 1,
          "title": "List Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "list_id",
        "title",
        "items"
      ],
      "title": "EntityList",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "device_id",
        "label"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "label",
        "value"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "ExcludedDevice": {
      "additionalProperties": false,
      "description": "One device a check did not cover, with a code-written reason a person can read.",
      "properties": {
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "enum": [
            "out_of_scope",
            "unknown_version",
            "insufficient_history",
            "no_reading",
            "no_readings"
          ],
          "title": "Reason",
          "type": "string"
        },
        "reason_text": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Reason Text",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "label",
        "reason",
        "reason_text"
      ],
      "title": "ExcludedDevice",
      "type": "object"
    },
    "ProposalCard": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "remediation_ticket",
            "replacement_flag",
            "upgrade_order",
            "employee_notification"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_effect": {
          "title": "Expected Effect",
          "type": "string"
        },
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "executed",
            "failed",
            "uncertain",
            "invalidated"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_device_id": {
          "title": "Target Device Id",
          "type": "string"
        },
        "target_label": {
          "title": "Target Label",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "action_type",
        "company_id",
        "target_device_id",
        "target_label",
        "rationale",
        "evidence_refs",
        "scope",
        "expected_effect",
        "status",
        "payload_hash"
      ],
      "title": "ProposalCard",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "description": "One device (or one device and finding) in a table. `refs` are its sources, all in `evidence`.",
      "properties": {
        "cells": {
          "additionalProperties": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Cells",
          "type": "object"
        },
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "label",
        "cells",
        "refs"
      ],
      "title": "Row",
      "type": "object"
    },
    "ScopeInfo": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "calculation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "population": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "company_id",
        "as_of",
        "rule",
        "population",
        "calculation"
      ],
      "title": "ScopeInfo",
      "type": "object"
    },
    "ScopeLine": {
      "additionalProperties": false,
      "description": "The counts behind the footer line: what was checked, what matched, what was left out.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "basis": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "checked": {
          "minimum": 0,
          "title": "Checked",
          "type": "integer"
        },
        "company_name": {
          "default": "",
          "maxLength": 120,
          "title": "Company Name",
          "type": "string"
        },
        "matched": {
          "minimum": 0,
          "title": "Matched",
          "type": "integer"
        },
        "not_checked": {
          "minimum": 0,
          "title": "Not Checked",
          "type": "integer"
        },
        "ok": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ok"
        },
        "ok_label": {
          "default": "",
          "maxLength": 40,
          "title": "Ok Label",
          "type": "string"
        }
      },
      "required": [
        "checked",
        "matched",
        "ok",
        "ok_label",
        "not_checked",
        "company_name",
        "basis",
        "as_of"
      ],
      "title": "ScopeLine",
      "type": "object"
    },
    "SortSpec": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "direction"
      ],
      "title": "SortSpec",
      "type": "object"
    },
    "SuggestedAction": {
      "additionalProperties": false,
      "description": "One action the agent recommends. It is advice only: acting is a separate, approved proposal.\n\n`request` is the natural-language message the UI sends when the user picks the suggestion.",
      "properties": {
        "action_type": {
          "enum": [
            "remediation_ticket",
            "replacement_flag",
            "upgrade_order",
            "employee_notification"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "device_id": {
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "target_label": {
          "minLength": 1,
          "title": "Target Label",
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "device_id",
        "target_label",
        "label",
        "reason",
        "request",
        "refs"
      ],
      "title": "SuggestedAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only shape the agent returns. The UI maps it to fixed components; the LLM never emits markup.",
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "maxItems": 4,
      "title": "Alternatives",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_lists": {
      "items": {
        "$ref": "#/$defs/EntityList"
      },
      "title": "Entity Lists",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation"
    },
    "follow_ups": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "maxItems": 4,
      "title": "Follow Ups",
      "type": "array"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "answer",
        "no_match",
        "insufficient_data",
        "clarification",
        "proposal",
        "denied",
        "unsupported",
        "tool_error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "no_matching_records",
            "insufficient_history",
            "not_found",
            "off_topic",
            "unsupported_action",
            "prompt_injection",
            "tool_failure",
            "step_limit",
            "not_eligible",
            "insufficient_evidence",
            "already_done",
            "too_many_pending",
            "data_unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "repeat_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repeat Of"
    },
    "scope": {
      "$ref": "#/$defs/ScopeInfo"
    },
    "scope_line": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "suggested_actions": {
      "items": {
        "$ref": "#/$defs/SuggestedAction"
      },
      "title": "Suggested Actions",
      "type": "array"
    },
    "summary": {
      "default": "",
      "maxLength": 200,
      "title": "Summary",
      "type": "string"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerTable"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "trace_id",
    "headline",
    "claims",
    "evidence",
    "scope",
    "clarification",
    "proposal",
    "notes",
    "coverage",
    "entity_lists",
    "suggested_actions",
    "reason_code",
    "explanation",
    "alternatives",
    "table",
    "summary",
    "scope_line",
    "follow_ups",
    "repeat_of"
  ],
  "title": "AnswerEnvelope",
  "type": "object"
}
