# Azure OpenAI (needed from plan 2 onward; leave blank until you have them)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Model mode: replay (default, offline, uses recorded responses) | live (Azure OpenAI)
FLEET_MODEL_MODE=replay
# Optional. Sampling temperature for live calls, 0 to 1 (default 0)
FLEET_MODEL_TEMPERATURE=
# Optional. A label for the model behind the deployment, recorded with eval runs
# (default: the deployment name). It does not change which deployment is called.
FLEET_MODEL_NAME=

# API server (127.0.0.1 only)
FLEET_PORT=8000
FLEET_SESSION_SECRET=
FLEET_OPERATOR_PASSCODE=
FLEET_ALLOWED_ORIGINS=

# Recorded model responses
FLEET_CASSETTE_PATH=
FLEET_CASSETTE_RECORD=false
FLEET_STATE_DIR=

# Optional LangSmith export (off by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional overrides (defaults resolve inside the repository)
FLEET_DATA_PATH=
FLEET_DB_PATH=
