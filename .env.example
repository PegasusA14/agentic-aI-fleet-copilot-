# Model provider for live mode: azure (default) | openai | openrouter. Fill in only the block you use.
FLEET_MODEL_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI. The model is required, for example gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, https only: an OpenAI-compatible endpoint
OPENAI_BASE_URL=

# OpenRouter. The model is required and must support tool calling, for example openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional, sent as the X-Title header (default Fleet Copilot)
OPENROUTER_APP_NAME=

# Model mode: replay (default, offline, uses recorded responses) | live (the provider above)
FLEET_MODEL_MODE=replay
# Optional. Sampling temperature for live calls, 0 to 1 (default 0)
FLEET_MODEL_TEMPERATURE=
# Optional. A label for the model, recorded with eval runs (default: the deployment or
# model name). It does not change which model is called.
FLEET_MODEL_NAME=

# API server (127.0.0.1 only)
FLEET_PORT=8000
FLEET_SESSION_SECRET=
FLEET_OPERATOR_PASSCODE=
FLEET_ALLOWED_ORIGINS=

# Recorded model responses
FLEET_CASSETTE_PATH=
FLEET_CASSETTE_RECORD=false
FLEET_STATE_DIR=

# Optional LangSmith export (off by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional overrides (defaults resolve inside the repository)
FLEET_DATA_PATH=
FLEET_DB_PATH=
