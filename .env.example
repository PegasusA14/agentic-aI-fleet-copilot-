# Azure OpenAI (needed from plan 2 onward; leave blank until you have them)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Model mode: scripted | replay | live
FLEET_MODEL_MODE=replay

# Optional LangSmith export (off by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional overrides (defaults resolve inside the repository)
FLEET_DATA_PATH=
FLEET_DB_PATH=
